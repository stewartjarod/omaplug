# Maintainer: Jarod Stewart <stewartjarod at gmail dot com>
pkgname=omaplug
pkgver=0.2.0
pkgrel=1
pkgdesc="Search, install, and audit Omarchy shell plugins from the community marketplace, pinned to verified commits"
arch=('any')
url="https://github.com/stewartjarod/omaplug"
license=('MIT')
depends=('bash' 'jq' 'curl' 'git' 'coreutils')
optdepends=('gum: nicer confirmation prompts')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fc453398310a714c539eab314c4952755b300ff74a96177c256a13fea7b962ed')

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
