pkgname=omarket
pkgver=0.3.1
pkgrel=1
pkgdesc="Search, install, and audit Omarchy shell plugins from the community marketplace, pinned to verified commits"
arch=('any')
url="https://github.com/stewartjarod/omarket"
license=('MIT')
depends=('bash' 'jq' 'curl' 'git' 'coreutils')
optdepends=('gum: nicer confirmation prompts')
conflicts=('omaplug')
replaces=('omaplug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('528fc1a6aa7e07d8cc837029b85eece498917c6c505ffa5b4ed2fd9d306cf3fd')

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
